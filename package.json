{
  "name": "dearie",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "PLAYWRIGHT_PORT=5173 playwright test",
    "verify:critical": "PLAYWRIGHT_PORT=5174 playwright test tests/critical-flows.spec.ts",
    "verify:screenshots": "PLAYWRIGHT_PORT=5175 playwright test tests/dashboard-visual.spec.ts",
    "verify:all": "npm audit --omit=dev && npm run build && npm run verify:screenshots && npm run verify:critical",
    "verify:release": "npm run verify:all",
    "video:render": "remotion render src/video/index.ts WeddingVideo out/wedding-video.mp4 --props=./wedding-video-props.json",
    "video:studio": "remotion studio src/video/index.ts"
  },
  "dependencies": {
    "@remotion/player": "^4.0.461",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/blob": "^2.4.0",
    "@vercel/og": "^0.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "remotion": "^4.0.461"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@remotion/cli": "^4.0.461",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
